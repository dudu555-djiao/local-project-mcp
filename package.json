{
  "name": "local-project-mcp",
  "version": "0.2.0-beta.2",
  "private": true,
  "type": "module",
  "description": "A local folder MCP with opt-in text editing and a native macOS manager",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node src/server.js",
    "stdio": "node src/server.js --stdio",
    "test": "node --test tests/*.test.js",
    "check:privacy": "python3 scripts/check-public-files.py"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "@xmldom/xmldom": "0.9.12",
    "fflate": "0.8.3",
    "pdfjs-dist": "6.4.299",
    "rtf-parser": "1.3.3",
    "zod": "^3.25.76"
  },
  "license": "MIT",
  "devDependencies": {
    "pdf-lib": "1.17.1"
  }
}
